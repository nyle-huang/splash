FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/product_campaign_pipeline

COPY pyproject.toml README.md requirements.runpod.txt ./
COPY src ./src
COPY data/creative_ranking/retrieval_index.train_top1024.json ./data/creative_ranking/retrieval_index.train_top1024.json

RUN python3 -m venv /opt/venv \
 && pip install --upgrade pip setuptools wheel \
 && pip install --index-url https://download.pytorch.org/whl/cu128 \
    torch==2.7.1 \
    torchvision==0.22.1 \
 && pip install -e ".[generation,vision,storage,gpu]" \
 && pip install -r requirements.runpod.txt \
 && python -m compileall -q src


FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ARG PCP_IMAGE_BUILD_SHA=unknown

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PCP_IMAGE_BUILD_SHA=$PCP_IMAGE_BUILD_SHA \
    HF_HOME=/runpod-volume/hf_home \
    PCP_OUTPUT_ROOT=/runpod-volume/runtime_outputs \
    PCP_WORKER_LOG_PATH=/runpod-volume/logs/runpod_worker.log \
    PCP_RETRIEVAL_INDEX_PATH=/workspace/product_campaign_pipeline/data/creative_ranking/retrieval_index.train_top1024.json \
    PCP_DEVICE=cuda \
    PCP_ANALYSIS_DEVICE=cpu \
    PCP_LOCALIZATION_DEVICE=cuda \
    PCP_WIDTH=512 \
    PCP_HEIGHT=512 \
    PCP_NUM_INFERENCE_STEPS=4 \
    PCP_GUIDANCE_SCALE=1.0 \
    PCP_TOP_K=5 \
    PCP_WARMUP_ON_START=0 \
    PCP_WARMUP_GENERATION_ON_START=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    python3 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/product_campaign_pipeline

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /workspace/product_campaign_pipeline/src ./src
COPY --from=builder /workspace/product_campaign_pipeline/data ./data

RUN mkdir -p /runpod-volume/runtime_outputs /runpod-volume/hf_home /runpod-volume/logs

CMD ["python", "-m", "product_campaign_pipeline.runpod_entrypoint"]
